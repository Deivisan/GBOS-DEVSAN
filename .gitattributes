# This repo is built and run on Linux (the stick, docker, WSL). Scripts must keep LF in the working tree or
# `sh build.sh` dies with "set: Illegal option -" on a Windows checkout (core.autocrlf=true).
*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.layout text eol=lf
*.tsv   text eol=lf
*.sed   text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf
