# This repo is built and run on Linux (the stick, docker, WSL). Scripts must keep LF in the working tree or
# `sh build.sh` dies with "set: Illegal option -" on a Windows checkout (core.autocrlf=true).
*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.layout text eol=lf
*.tsv   text eol=lf
*.sed   text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Extension-less text files that scripts read/source. lapis/BUILD is sourced by build.sh: with CRLF the download URL
# ends in a \r and curl answers "URL rejected: Malformed input to a URL function".
lapis/BUILD                    text eol=lf
kernel/ci/BUILD_INFO           text eol=lf
kernel/docker/Dockerfile       text eol=lf
tools/erofs-docker/Dockerfile  text eol=lf
kernel/v4l2loopback/Makefile   text eol=lf
